<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <Version>1.0.1</Version>
	  <Authors>itsvse</Authors>
	  <Copyright>Copyright © 2025 itsvse.com</Copyright>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <PackageTags>grpc health healthcheck</PackageTags>
	  <PackageProjectUrl>https://github.com/itsvse/grpc-healthcheck</PackageProjectUrl>
	  <Description>Sw.Grpc.HealthCheck contains the reference implementation of gRPC health check service.</Description>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

	<ItemGroup>
		<Protobuf Include="Protos\HealthCheckService.proto" GrpcServices="Server" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore" Version="2.57.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\README.md" Pack="true" Link="README.md" PackagePath="\" />
	</ItemGroup>
</Project>
